{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Qura",
  "scopeName": "source.qura",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#function_declaration"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#types"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#function_calls"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#delimiters"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.qura",
          "match": "//.*$"
        },
        {
          "name": "comment.block.qura",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [
            {
              "include": "#comments"
            }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.qura",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.qura",
              "match": "\\\\[nrt\\\\\"]"
            },
            {
              "name": "invalid.illegal.unknown-escape.qura",
              "match": "\\\\[^nrt\\\\\"]"
            }
          ]
        }
      ]
    },
    "function_declaration": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "keyword.declaration.function.qura"
            },
            "2": {
              "name": "entity.name.function.declaration.qura"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.qura",
          "match": "\\b(if|else|while|return)\\b"
        },
        {
          "name": "keyword.declaration.function.qura",
          "match": "\\b(fn)\\b"
        },
        {
          "name": "storage.type.variable.qura",
          "match": "\\b(let)\\b"
        },
        {
          "name": "storage.modifier.mut.qura",
          "match": "\\b(mut)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.qura",
          "match": "\\b(print|println)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.primitive.qura",
          "match": "\\b(i32|i64|u32|u64|f64|bool|str)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.qura",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.qura",
          "match": "\\b0[xX][0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.binary.qura",
          "match": "\\b0[bB][01_]+\\b"
        },
        {
          "name": "constant.numeric.float.qura",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9][0-9_]*)?\\b"
        },
        {
          "name": "constant.numeric.integer.decimal.qura",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "function_calls": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.call.qura"
            }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.qura",
          "match": "->"
        },
        {
          "name": "keyword.operator.comparison.qura",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical.qura",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.assignment.qura",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.qura",
          "match": "(\\+|\\-|\\*|/|%)"
        }
      ]
    },
    "delimiters": {
      "patterns": [
        {
          "name": "punctuation.separator.qura",
          "match": "(;|:|,)"
        },
        {
          "name": "punctuation.brackets.qura",
          "match": "(\\(|\\)|\\{|\\}|\\[|\\])"
        }
      ]
    }
  }
}
